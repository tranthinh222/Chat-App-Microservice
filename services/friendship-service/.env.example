# Friendship Service runtime
PORT=3002

# Local PostgreSQL connection used outside Docker
DATABASE_URL=postgresql://friendship_app:friendship_app@localhost:5433/friendship_db

# Must match User Service JWT_ACCESS_SECRET during the MVP phase
JWT_ACCESS_SECRET=<same-secret-as-user-service>

# Internal User Service client
USER_SERVICE_URL=http://localhost:3001
USER_SERVICE_REQUEST_TIMEOUT_MS=3000
