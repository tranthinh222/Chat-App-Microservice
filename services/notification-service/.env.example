# Notification Service runtime
PORT=3003

# Local PostgreSQL connection used outside Docker
DATABASE_URL=postgresql://notification_app:notification_app@localhost:5434/notification_db

# Must match User Service JWT_ACCESS_SECRET during the MVP phase
JWT_ACCESS_SECRET=<same-secret-as-user-service>
CORS_ALLOWED_ORIGIN=http://localhost:5173

# Kafka consumer
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=notification-service
KAFKA_CONSUMER_GROUP_ID=notification-service-v1
