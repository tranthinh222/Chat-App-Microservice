# Docker images
POSTGRES_DOCKER_IMAGE=postgres:17-alpine

# User Service PostgreSQL container
USER_POSTGRES_DATABASE=chat_app
USER_POSTGRES_USERNAME=chat_app
USER_POSTGRES_PASSWORD=chat_app
USER_DATABASE_INTERNAL_URL=postgresql://chat_app:chat_app@user-postgres:5432/chat_app

# Friendship Service PostgreSQL container
FRIENDSHIP_POSTGRES_DATABASE=friendship_db
FRIENDSHIP_POSTGRES_USERNAME=friendship_app
FRIENDSHIP_POSTGRES_PASSWORD=friendship_app
FRIENDSHIP_POSTGRES_HOST_PORT=5433
FRIENDSHIP_DATABASE_INTERNAL_URL=postgresql://friendship_app:friendship_app@friendship-postgres:5432/friendship_db

# Container listening ports
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
FRIENDSHIP_SERVICE_PORT=3002
WEB_HOST_PORT=4173

# Shared access-token verification
SHARED_JWT_ACCESS_SECRET=replace-with-a-long-random-secret
USER_ACCESS_TOKEN_EXPIRES_IN=15m
USER_REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Internal service URLs and browser origin
API_GATEWAY_CORS_ALLOWED_ORIGIN=http://localhost:4173
USER_SERVICE_INTERNAL_URL=http://user-service:3001
FRIENDSHIP_USER_SERVICE_REQUEST_TIMEOUT_MS=3000
WEB_API_GATEWAY_INTERNAL_URL=http://api-gateway:3000
