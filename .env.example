POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=chat_app
POSTGRES_USER=chat_app
POSTGRES_PASSWORD=chat_app
DATABASE_URL=postgresql://chat_app:chat_app@postgres:5432/chat_app
FRIENDSHIP_POSTGRES_DB=friendship_db
FRIENDSHIP_POSTGRES_USER=friendship_app
FRIENDSHIP_POSTGRES_PASSWORD=friendship_app
FRIENDSHIP_POSTGRES_PORT=5433
FRIENDSHIP_DATABASE_URL=postgresql://friendship_app:friendship_app@friendship-postgres:5432/friendship_db

USER_SERVICE_PORT=3001
FRIENDSHIP_SERVICE_PORT=3002
API_GATEWAY_PORT=3000
WEB_PORT=4173

JWT_ACCESS_SECRET=local-development-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

CLIENT_ORIGIN=http://localhost:4173
AUTH_SERVICE_URL=http://auth-service:3001
API_GATEWAY_URL=http://api-gateway:3000
