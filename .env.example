# Docker images
POSTGRES_DOCKER_IMAGE=postgres:17-alpine
KAFKA_DOCKER_IMAGE=apache/kafka:4.3.0
KAFKA_UI_DOCKER_IMAGE=ghcr.io/kafbat/kafka-ui:v1.5.0

# Kafka tools exposed only on the local host
KAFKA_EXTERNAL_PORT=9092
KAFKA_UI_PORT=8085

# User Service PostgreSQL container
USER_POSTGRES_DATABASE=chat_app
USER_POSTGRES_USERNAME=chat_app
USER_POSTGRES_PASSWORD=chat_app
USER_DATABASE_INTERNAL_URL=postgresql://chat_app:chat_app@user-postgres:5432/chat_app

# Friendship Service PostgreSQL container
FRIENDSHIP_POSTGRES_DATABASE=friendship_db
FRIENDSHIP_POSTGRES_USERNAME=friendship_app
FRIENDSHIP_POSTGRES_PASSWORD=friendship_app
FRIENDSHIP_POSTGRES_HOST_PORT=5433
FRIENDSHIP_DATABASE_INTERNAL_URL=postgresql://friendship_app:friendship_app@friendship-postgres:5432/friendship_db

# Notification Service PostgreSQL container
NOTIFICATION_POSTGRES_DATABASE=notification_db
NOTIFICATION_POSTGRES_USERNAME=notification_app
NOTIFICATION_POSTGRES_PASSWORD=notification_app
NOTIFICATION_POSTGRES_HOST_PORT=5434
NOTIFICATION_DATABASE_INTERNAL_URL=postgresql://notification_app:notification_app@notification-postgres:5432/notification_db

# Container listening ports
API_GATEWAY_PORT=3000
USER_SERVICE_PORT=3001
FRIENDSHIP_SERVICE_PORT=3002
FRIENDSHIP_KAFKA_BROKERS=kafka:29092
FRIENDSHIP_KAFKA_CLIENT_ID=friendship-service
FRIENDSHIP_OUTBOX_BATCH_SIZE=50
FRIENDSHIP_OUTBOX_POLL_INTERVAL_MS=1000
FRIENDSHIP_OUTBOX_RETRY_BASE_DELAY_MS=1000
FRIENDSHIP_OUTBOX_RETRY_MAX_DELAY_MS=30000
NOTIFICATION_SERVICE_PORT=3003
NOTIFICATION_KAFKA_BROKERS=kafka:29092
NOTIFICATION_KAFKA_CLIENT_ID=notification-service
NOTIFICATION_KAFKA_CONSUMER_GROUP_ID=notification-service-v1
WEB_HOST_PORT=4173

# Shared access-token verification
SHARED_JWT_ACCESS_SECRET=replace-with-a-long-random-secret
USER_ACCESS_TOKEN_EXPIRES_IN=15m
USER_REFRESH_TOKEN_EXPIRES_IN_DAYS=30

# Internal service URLs and browser origin
API_GATEWAY_CORS_ALLOWED_ORIGIN=http://localhost:4173
USER_SERVICE_INTERNAL_URL=http://user-service:3001
FRIENDSHIP_SERVICE_INTERNAL_URL=http://friendship-service:3002
FRIENDSHIP_USER_SERVICE_REQUEST_TIMEOUT_MS=3000
NOTIFICATION_SERVICE_INTERNAL_URL=http://notification-service:3003
WEB_API_GATEWAY_INTERNAL_URL=http://api-gateway:3000
