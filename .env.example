POSTGRES_IMAGE=postgres:17-alpine
POSTGRES_DB=chat_app
POSTGRES_USER=chat_app
POSTGRES_PASSWORD=chat_app
DATABASE_URL=postgresql://chat_app:chat_app@postgres:5432/chat_app

USER_SERVICE_PORT=3001
API_GATEWAY_PORT=3000
WEB_PORT=4173

JWT_ACCESS_SECRET=local-development-secret-change-in-production
JWT_ACCESS_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN_DAYS=30

CLIENT_ORIGIN=http://localhost:4173
AUTH_SERVICE_URL=http://auth-service:3001
API_GATEWAY_URL=http://api-gateway:3000
